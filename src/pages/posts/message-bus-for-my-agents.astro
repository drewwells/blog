// =============================================================================
// "I built a message bus so my AI agents could run my servers."
//
// Integration approach (per the design handoff README + this blog's house
// pattern): the blog is pure-static Astro with NO React. The two existing
// posts ship their interactive charts as a dependency-free vanilla-JS island
// loaded via `is:inline` <script> from /public/posts/<slug>/. This post
// follows that exact convention rather than adding @astrojs/react: the eight
// content sections are authored as static .astro markup with a page-scoped
// stylesheet (portfolio.css tokens ported verbatim, OKLCH preserved), and the
// three interactive figures (bridge control plane, Telegram sequence, MoE
// bars) plus the progress bar / rail nav / scroll-reveal are rebuilt 1:1 in
// vanilla JS in bus.js with the prototype's exact timing constants. This keeps
// the build pure-static (no React/Babel shipped), matches the established
// per-post JS-island pattern, and satisfies the README's "small client-side
// components" guidance for static sites.
// =============================================================================
import PostLayout from '../../layouts/PostLayout.astro';
import { getPost } from '../../posts';
import '../../styles/posts/message-bus-for-my-agents.css';

const post = getPost('message-bus-for-my-agents');

const shots = '/posts/message-bus-for-my-agents/shots';
const apps = [
  {
    name: 'plex-host',
    dom: 'dance.jayloves.us',
    shot: `${shots}/plex-host.webp`,
    pos: 'center 36%',
    one: "Auth'd vault for managing my 900 dance videos — transcriptions, search, LLM chat, automated tagging, and A/B practice looping.",
    chips: ['Go', 'SvelteKit', 'Whisper', 'Qwen3', 'FFmpeg QSV'],
  },
  {
    name: 'swing-analytics',
    dom: 'swingelo.com',
    shot: `${shots}/swing-analytics.webp`,
    pos: 'center top',
    one: 'West Coast Swing results warehouse — 132,750 entries across ~175 events, 7-phase name normalization.',
    chips: ['Python', 'DuckDB', 'Go API'],
  },
  {
    name: 'swingschedule',
    dom: 'schedule.swingelo.com',
    shot: `${shots}/swingschedule.webp`,
    pos: 'center top',
    one: 'Event-schedule aggregator + webcal feed, with vision-LLM PDF→JSON ingestion.',
    chips: ['Next.js 15', 'vision-LLM', 'Gemma'],
  },
  {
    name: 'docs',
    dom: 'docs.swingelo.com',
    shot: `${shots}/docs.webp`,
    pos: 'center top',
    one: 'Public methodology docs — how strength scores, odds-to-finals, and the ranking models actually work.',
    chips: ['docs', 'methodology'],
  },
  {
    name: 'speed',
    dom: 'speed.jayloves.us',
    shot: `${shots}/speed.webp`,
    pos: 'center top',
    one: 'Hosting on T-Mobile Home Internet took heavy tuning — measurements surfaced issues with proxy_buffering, BBR congestion control, and per-chunk network flushing.',
    chips: ['nginx', 'BBR', 'benchmark'],
  },
  {
    name: 'gym',
    dom: 'gym.jayloves.us',
    shot: `${shots}/gym.webp`,
    pos: 'center top',
    // Finalized copy from the gym project owner (replaced the design's placeholder).
    one: 'Open-floor finder for 4 gym brands — normalizes 2 JSON APIs and 2 HTML scrapes into “when is the dance studio actually free between classes?”',
    chips: ['Node.js', 'Express', 'vanilla JS', 'Podman'],
  },
];

const themes = [
  {
    t: 'Agents as operators, not chatbots',
    d: 'I’m not running LLM chatbots — I’m building autonomous workflows that only ping a human when past context can’t answer the operational question.',
  },
  {
    t: 'Microservice architecture',
    d: 'I leaned on my architecture experience to build tolerant systems that respond in reasonable time: identity arbitration, at-least-once messaging, leases and heartbeats — applied to real local projects, not slideware.',
  },
  {
    t: 'Sovereign where it counts',
    d: 'It all runs on my own hardware today, ISP limits aside. Inference still leans on the cloud, but local models are there to fall back to when a provider has an outage.',
  },
  {
    t: 'It learns as it runs',
    d: 'Watchdogs run continuously and still respect a session I’m attached to. Memory doesn’t start from scratch each session — it builds on a persistent store that’s optimized nightly in a “dream” pass, accruing real operational experience and learning from past mistakes.',
  },
];

const sites = [
  'swingelo.com',
  'schedule.swingelo.com',
  'docs.swingelo.com',
  'dance.jayloves.us',
  'speed.jayloves.us',
  'gym.jayloves.us',
];
---

<PostLayout post={post}>
  <!-- fixed scroll-progress bar + right-edge rail nav -->
  <div class="progress" id="progress"></div>
  <nav class="railnav" id="railnav" aria-label="Section navigation">
    <a href="#top" data-sec="top">●</a>
    <a href="#s1" data-sec="s1">01</a>
    <a href="#s2" data-sec="s2">02</a>
    <a href="#s3" data-sec="s3">03</a>
    <a href="#s4" data-sec="s4">04</a>
    <a href="#s5" data-sec="s5">05</a>
    <a href="#s6" data-sec="s6">06</a>
  </nav>

  <div class="article" id="top">
    <!-- ===================== MASTHEAD ===================== -->
    <header class="masthead reveal" data-screen-label="Masthead">
      <div class="wrap">
        <div class="mast-top">
          <span>WELLSSTAR &middot; PORTFOLIO / 2026</span>
          <span class="r"><span class="dot"></span>SYSTEM NOMINAL</span>
        </div>
        <div class="kicker">HOMELAB / AGENT INFRASTRUCTURE</div>
        <h1 class="headline">I built a message bus so my AI agents could run my servers.<span class="cur"></span></h1>
        <p class="dek">Agents talk to each other over a custom WebSocket bridge &mdash; with leader election and a Telegram voice bridge &mdash; so I can run every machine through one elected leader. It spans two architectures, <b>Linux and macOS</b>, with supervisors keeping it fault-tolerant, and it pages me when it hits something it can't resolve.</p>
        <div class="byline"><b>Drew Wells</b> &nbsp;&middot;&nbsp; June 2026 &nbsp;&middot;&nbsp; wellsstar.dev</div>
        <div class="strip">
          <div class="stat"><div class="n">4<small>+2</small></div><div class="l">Machines on the fabric &middot; 2 VPS ingress</div></div>
          <div class="stat"><div class="n">6</div><div class="l">Production apps kept alive</div></div>
          <div class="stat"><div class="n">8</div><div class="l">MCP tools every agent can call</div></div>
          <div class="stat"><div class="n">2</div><div class="l">OS families &middot; one watchdog model</div></div>
        </div>
      </div>
    </header>

    <!-- ===================== 01 · SUBSTRATE ===================== -->
    <section class="section" id="s1">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">01</div>
          <div class="sec-titles">
            <div class="sub">The substrate</div>
            <h2>One logical fabric, unlimited machines</h2>
          </div>
        </div>
        <div class="prose col">
          <p class="lead">My homelab used to be one server with a pile of containers on it. Now it's a small fleet &mdash; addressable units I can work on independently, moving workloads between them as a project's scope changes.</p>
          <p>The fabric is tied together with a <b>Tailscale mesh</b> for end-to-end encryption between every node, and I drop into <code>tmux</code> when I need to focus on one part of the system. The machines range in size: small cloud VPS, a <b>16-core 128&nbsp;GB x86</b> Linux box, an <b>M4 Max with 128&nbsp;GB</b> for local inference, and hourly RunPod rentals when a job needs more muscle than I own.</p>
          <p>Messages have queues, supervisors that hold response times to account, and leader election to resolve contention &mdash; all of it there to manage context across the variety of complex problems each project throws at it.</p>
        </div>

        <div class="reveal col">
          <figure class="figure">
            <div class="fig-bar"><span class="tag">FIG. 01</span><span>THE SHARED BRAIN</span><span>MEMORY &middot; SYNCTHING</span></div>
            <div class="fig-body">
              <div class="col" style="max-width:none;padding:10px 8px">
                <svg viewBox="0 0 860 340" style="width:100%;display:block" role="img" aria-label="Two memory layers: a transient WebSocket message bus on top, and below it a durable cross-machine memory store (the ~/.claude-memory knowledge base, replicated by Syncthing) into which this blog's own .knowledge directory is symlinked">
                  <!-- TRANSIENT tier -->
                  <rect x="20" y="16" width="820" height="96" rx="10" fill="oklch(0.20 0.014 250 / .5)" stroke="oklch(0.370 0.014 250)" stroke-dasharray="3 4"></rect>
                  <text x="34" y="38" font-family="var(--mono)" font-size="11" font-weight="600" fill="oklch(0.640 0.012 250)">TRANSIENT &middot; the message bus</text>
                  <rect x="118" y="52" width="138" height="34" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="187" y="73" text-anchor="middle" font-family="var(--mono)" font-size="10" fill="#ddd">coo@amazon</text>
                  <rect x="361" y="52" width="138" height="34" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="430" y="73" text-anchor="middle" font-family="var(--mono)" font-size="10" fill="#ddd">coder@beast</text>
                  <rect x="604" y="52" width="138" height="34" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="673" y="73" text-anchor="middle" font-family="var(--mono)" font-size="10" fill="#ddd">pm@amazon</text>
                  <line x1="256" y1="69" x2="361" y2="69" stroke="oklch(0.370 0.014 250)" stroke-width="1" stroke-dasharray="5 4"></line>
                  <line x1="499" y1="69" x2="604" y2="69" stroke="oklch(0.370 0.014 250)" stroke-width="1" stroke-dasharray="5 4"></line>
                  <text x="308" y="64" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="oklch(0.640 0.012 250)">msg &rarr; ack</text>
                  <text x="551" y="64" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="oklch(0.640 0.012 250)">msg &rarr; ack</text>
                  <text x="826" y="104" text-anchor="end" font-family="var(--mono)" font-size="9" fill="oklch(0.640 0.012 250)">WebSocket &middot; at-least-once &middot; gone after delivery</text>
                  <!-- DURABLE tier -->
                  <rect x="20" y="128" width="820" height="196" rx="10" fill="oklch(0.20 0.014 250 / .5)" stroke="oklch(0.805 0.135 78 / .5)" stroke-dasharray="3 4"></rect>
                  <text x="34" y="150" font-family="var(--mono)" font-size="11" font-weight="600" fill="oklch(0.805 0.135 78)">DURABLE &middot; the shared brain</text>
                  <!-- three replicas -->
                  <rect x="64" y="168" width="172" height="48" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="150" y="188" text-anchor="middle" font-family="var(--mono)" font-size="11" font-weight="600" fill="#ddd">amazon</text>
                  <text x="150" y="203" text-anchor="middle" font-family="var(--mono)" font-size="8.5" fill="oklch(0.640 0.012 250)">~/.claude-memory</text>
                  <rect x="344" y="168" width="172" height="48" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="430" y="188" text-anchor="middle" font-family="var(--mono)" font-size="11" font-weight="600" fill="#ddd">beast</text>
                  <text x="430" y="203" text-anchor="middle" font-family="var(--mono)" font-size="8.5" fill="oklch(0.640 0.012 250)">~/.claude-memory</text>
                  <rect x="624" y="168" width="172" height="48" rx="6" fill="oklch(0.238 0.016 250)" stroke="oklch(0.370 0.014 250)"></rect>
                  <text x="710" y="188" text-anchor="middle" font-family="var(--mono)" font-size="11" font-weight="600" fill="#ddd">opnsense</text>
                  <text x="710" y="203" text-anchor="middle" font-family="var(--mono)" font-size="8.5" fill="oklch(0.640 0.012 250)">~/.claude-memory</text>
                  <!-- syncthing replication arrows -->
                  <line x1="236" y1="192" x2="344" y2="192" stroke="oklch(0.805 0.135 78)" stroke-width="1.3" stroke-dasharray="5 4" opacity="0.8"></line>
                  <line x1="516" y1="192" x2="624" y2="192" stroke="oklch(0.805 0.135 78)" stroke-width="1.3" stroke-dasharray="5 4" opacity="0.8"></line>
                  <text x="290" y="186" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="oklch(0.805 0.135 78)">&harr; Syncthing</text>
                  <text x="570" y="186" text-anchor="middle" font-family="var(--mono)" font-size="8" fill="oklch(0.805 0.135 78)">&harr; Syncthing</text>
                  <!-- blog symlink callout -->
                  <rect x="64" y="256" width="732" height="50" rx="8" fill="oklch(0.805 0.135 78 / .08)" stroke="oklch(0.805 0.135 78 / .6)"></rect>
                  <text x="80" y="277" font-family="var(--mono)" font-size="9.5" font-weight="600" fill="oklch(0.805 0.135 78)">this blog &middot; .knowledge/</text>
                  <text x="80" y="293" font-family="var(--mono)" font-size="9" fill="oklch(0.640 0.012 250)">&rarr; symlink &rarr; ~/.claude-memory/github-com-drewwells-blog/knowledge</text>
                  <text x="780" y="285" text-anchor="end" font-family="var(--mono)" font-size="9" fill="oklch(0.640 0.012 250)">same store the agents read</text>
                </svg>
              </div>
            </div>
            <figcaption class="fig-cap"><b>TAKEAWAY</b><span>Three layers: an ephemeral message bus, a 30-day context cache, and a persistent memory agents can query anytime. Each project gets its own memory, populated as costly or important details surface and tuned daily. That memory is symlinked into the project &mdash; including this blog, whose <code>.knowledge/</code> points straight into the same store the agents read.</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ===================== 02 · THE BRIDGE ===================== -->
    <section class="section" id="s2">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">02</div>
          <div class="sec-titles">
            <div class="sub">The bridge &mdash; centerpiece</div>
            <h2>A cross-machine message bus for agents</h2>
          </div>
        </div>
        <div class="prose col">
          <p class="lead">A Claude Code agent is an isolated process with a small context window. For a handful of them to act like one team &mdash; a lead delegating to PMs and coders across machines &mdash; they have to find each other, message reliably, and never step on each other's identity. The bridge is the two-layer Go system that makes that work.</p>
          <p>There's one <b>hub</b>, a WebSocket router at <code>ws://amazon.home.arpa:8991</code> that also keeps the registry of live sessions. Next to each agent runs a small <b>bridge MCP server</b> that hands the model the hub as tools it calls directly &mdash; <code>register</code>, <code>send</code>, <code>get_messages</code>, <code>ack</code>, <code>status</code>, <code>list_peers</code>, <code>hub_status</code>, <code>leader_status</code>. Every agent is <code>name@machine</code> and queues are per-machine, so the namespace stays human-readable on top of a distributed fabric.</p>
        </div>

        <div class="reveal" data-screen-label="Fig 02 — bridge">
          <figure class="figure">
            <div class="fig-bar"><span class="tag">FIG. 02</span><span>BRIDGE &mdash; LIVE CONTROL PLANE</span><span>INTERACTIVE</span></div>
            <div class="fig-body">
              <div style="background:oklch(0.172 0.012 250)">
                <div id="fig-bridge"></div>
              </div>
            </div>
            <figcaption class="fig-cap"><b>TAKEAWAY</b><span>Roles are leased, not assigned. The coo lease lasts 60s (2&times; the heartbeat); the hub sweeps expired leases every 5s. Expire the leader and it re-elects &mdash; but only on amazon, where the coo role is pinned in code.</span></figcaption>
          </figure>
        </div>

        <div class="prose col">
          <ul class="bullets">
            <li><b>Identity-collision detection.</b> Supervisors relaunch agents whenever they feel like it, so the hub won't hand out an identity a live process already holds. "Live" means a heartbeat in the last 60s &mdash; after that the old registration is a corpse and a fresh claim takes it. That's the line between a clean restart and a split brain.</li>
            <li><b>Lease-based leader election.</b> <code>claim_role</code> only succeeds if no live lease exists. Lease generations let me tell a renewal (same generation) from a real handover (<code>primary_changed</code>) &mdash; the same shape as etcd or ZooKeeper, just hand-rolled for a fleet of agents.</li>
            <li><b>Explicit acks.</b> The message store has <code>ack</code> / <code>status</code> semantics, so a sender can confirm a peer actually got a message &mdash; not just that it left.</li>
          </ul>
        </div>

        <div class="pquote col">
          <p>"The COO role is a lease, not a title. If the agent holding it stops sending heartbeats for sixty seconds, the lease expires and someone else can take over &mdash; but only on the one machine the code allows to hold it."</p>
          <div class="who">&mdash; On leader election</div>
        </div>
      </div>
    </section>

    <!-- ===================== 03 · TELEGRAM RELAY ===================== -->
    <section class="section" id="s3">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">03</div>
          <div class="sec-titles">
            <div class="sub">The Telegram relay</div>
            <h2>Control plane extends to my phone</h2>
          </div>
        </div>
        <div class="prose col">
          <p class="lead">I wanted to keep a project moving even when I'm away from my computer &mdash; commuting, or out at the gym taking a break. The relay is a persistently managed, bidirectional connection to Telegram: agents can reach me when they need to unblock work or diagnose an issue, and I can answer back.</p>
          <p>When I can't type, I dictate. Voice notes run through a <b>local Whisper</b> service &mdash; no cloud STT vendor involved &mdash; and the transcribed text goes over the relay to the right agent. Access controls sit in front so nothing reaches the bridge that shouldn't.</p>
        </div>

        <div class="reveal" data-screen-label="Fig 03 — telegram sequence">
          <figure class="figure">
            <div class="fig-bar"><span class="tag">FIG. 03</span><span>VOICE NOTE &rarr; AGENT &rarr; ACK</span><span>SEQUENCE &middot; INTERACTIVE</span></div>
            <div class="fig-body">
              <div style="background:oklch(0.172 0.012 250)">
                <div id="fig-sequence"></div>
              </div>
            </div>
            <figcaption class="fig-cap"><b>TAKEAWAY</b><span>Not fire-and-forget. A pending-ack tracker with timeouts detects when a relayed message wasn't picked up &mdash; and a degraded mode tells me it went unheard instead of failing silently. Toggle 'agent down' to see it.</span></figcaption>
          </figure>
        </div>

        <div class="prose col">
          <p>Every message over the bridge is watched for a response. An agent that doesn't answer is surfaced as an error in Telegram so I can act on it, common outages get escalated to me immediately, and automatic nudges try to clear the usual "stuck" behavior before it ever reaches me.</p>
        </div>

        <div class="pquote col">
          <p>"I don't just send a message &mdash; I expect a response, and the whole system is built around that."</p>
          <div class="who">&mdash; On the relay</div>
        </div>
      </div>
    </section>

    <!-- ===================== 04 · KEEPING IT ALIVE ===================== -->
    <section class="section" id="s4">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">04</div>
          <div class="sec-titles">
            <div class="sub">Keeping it alive</div>
            <h2>Supervision, local models, memory</h2>
          </div>
        </div>
        <div class="prose col">
          <p class="lead">This is the least glamorous part, and the one that actually matters: keeping all of it up on its own, across two operating systems that don't agree on much.</p>
          <p>Supervision has to work on both. Linux runs <code>systemd</code>, the Mac runs <code>launchd</code>, and a per-agent supervisor restarts crashed agents and wedged hubs under one shared model. The rule I learned the hard way: a supervisor <b>must never evict a session I'm actively attached to</b>. It only kills and recreates a pane when the process is genuinely dead &mdash; not when I'm sitting in it.</p>
        </div>

        <div class="reveal col" data-screen-label="Fig 04 — MoE bars">
          <figure class="figure">
            <div class="fig-bar"><span class="tag">FIG. 04</span><span>MoE vs DENSE &middot; LOCAL THROUGHPUT</span><span>oMLX / APPLE MLX</span></div>
            <div class="fig-body">
              <div style="background:oklch(0.205 0.014 250)">
                <div id="fig-moe"></div>
              </div>
            </div>
            <figcaption class="fig-cap"><b>TAKEAWAY</b><span>The benchmark that drives model choice. A mixture-of-experts model with 3B active params runs ~4&times; faster than a 27B dense model on the same machine &mdash; so on-prem inference is actually fast enough to depend on.</span></figcaption>
          </figure>
        </div>

        <div class="prose col">
          <ul class="bullets">
            <li><b>On-prem LLM serving.</b> Local inference is OpenAI-compatible, served through Apple MLX on <code>beast</code> and daemon-managed. The fallback chain runs local Qwen &rarr; local Gemma &rarr; cloud Claude, so no single machine is a hard dependency and a provider outage doesn't stop me.</li>
            <li><b>Persistent memory.</b> A 245-entry knowledge base syncs across every machine with Syncthing. Agents lose their context on a regular basis, so they survive by re-reading a <code>state.md</code> source-of-truth on every fresh boot &mdash; they don't start from zero.</li>
            <li><b>"Dream" consolidation.</b> Every night at 04:30 a timer mines the day's transcripts for anything worth keeping, runs a headless <code>claude -p</code> pass to merge duplicates, checks the result against seven validations, swaps it in atomically, and Telegrams me a one-line PASS/FAIL so I know it ran.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===================== 05 · WHAT IT RUNS ===================== -->
    <section class="section" id="s5">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">05</div>
          <div class="sec-titles">
            <div class="sub">What it runs</div>
            <h2>Real running projects</h2>
          </div>
        </div>
        <div class="prose col">
          <p>These started as a handful of interests &mdash; data processing, scheduling, and hosting private video to support my dancing hobby. I use the sites every day, so I expect the infrastructure to keep them running 24/7: not clumsy hobby projects, but something that holds up as well as any SaaS service overlapping the same use cases. As more of the critical features have landed, I've started wiring in cross-dependencies &mdash; the dance uploader can reach out to <b>swing-analytics</b> to suggest possible instructors in a video.</p>
        </div>
        <div class="reveal">
          <div class="apps-grid">
            {apps.map((a) => (
              <div class="app-card">
                <div class="shot">
                  <img src={a.shot} alt={`${a.name} — ${a.dom}`} loading="lazy" style={`object-position:${a.pos}`} />
                </div>
                <div class="body">
                  <div class="head">
                    <span class="name">{a.name}</span>
                    <span class="dom">{a.dom}</span>
                  </div>
                  <p class="one">{a.one}</p>
                  <div class="chips">
                    {a.chips.map((c) => <span class="chip">{c}</span>)}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== 06 · THEMES ===================== -->
    <section class="section" id="s6">
      <div class="wrap">
        <div class="sec-head col">
          <div class="sec-num">06</div>
          <div class="sec-titles">
            <div class="sub">Cross-cutting themes</div>
            <h2>Why this is the interesting part</h2>
          </div>
        </div>
        <div class="reveal">
          <div class="col themes-grid">
            {themes.map((th, i) => (
              <div class="cell">
                <div class="idx">0{i + 1}</div>
                <div class="t">{th.t}</div>
                <div class="d">{th.d}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== FOOTNOTE · CONNECTIVITY ===================== -->
    <section class="section" id="s-note">
